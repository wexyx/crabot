#!/usr/bin/env bash
set -euo pipefail
invocation_dir=$PWD
source_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
cd "$source_dir"

usage() {
  printf '%s\n' 'agent-node [start|run|proxy] [--cli] [--name ALIAS] [--server-port PORT] [--workdir PATH] [--outside-access ask|deny]' 'crabot [--workdir PATH] [--outside-access ask|deny]' '管理操作请直接与默认 Agent 对话。启动配置使用环境变量或 .agent.env。'
}
# Rust loads instance and invocation-directory .agent.env consistently with releases.
export CRABOT_LAUNCH_DIR="$invocation_dir"
command_name=start
if [[ $# -gt 0 && $1 != --* ]]; then command_name=$1; shift; fi
case "$command_name" in
  start|run) ;;
  proxy) export AGENT_MODE=proxy ;;
  help|-h) usage; exit 0 ;;
  *) usage >&2; exit 2 ;;
esac
startup_args=()
interactive=false
while [[ $# -gt 0 ]]; do
  case "$1" in
    --cli) interactive=true; startup_args+=(--cli); shift ;;
    --name|--server-port|--web-port)
      [[ $# -ge 2 ]] || { usage >&2; exit 2; }
      startup_args+=("$1" "$2"); shift 2 ;;
    --data-dir)
      [[ $# -ge 2 ]] || { usage >&2; exit 2; }
      directory=$2; [[ $directory == /* ]] || directory="$invocation_dir/$directory"
      startup_args+=(--data-dir "$directory"); shift 2 ;;
    --workdir)
      [[ $# -ge 2 ]] || { usage >&2; exit 2; }
      directory=$2; [[ $directory == /* ]] || directory="$invocation_dir/$directory"
      startup_args+=(--workdir "$directory"); shift 2 ;;
    --outside-access)
      [[ $# -ge 2 && ( $2 == ask || $2 == deny ) ]] || { usage >&2; exit 2; }
      startup_args+=(--outside-access "$2"); shift 2 ;;
    --help) usage; exit 0 ;;
    --version|-V) startup_args+=(--version); interactive=true; shift ;;
    *) usage >&2; exit 2 ;;
  esac
done
# Let Rust resolve home-based defaults; only normalize explicitly configured paths.
if [[ -n ${AGENT_WORKDIR:-} && $AGENT_WORKDIR != /* ]]; then export AGENT_WORKDIR="$invocation_dir/$AGENT_WORKDIR"; fi
if [[ -n ${CRABOT_DATA_DIR:-} && $CRABOT_DATA_DIR != /* ]]; then export CRABOT_DATA_DIR="$invocation_dir/$CRABOT_DATA_DIR"; fi
export CRABOT_BUNDLED_SYSTEM_SKILLS_DIR="$source_dir/skills/system"
export CRABOT_BUNDLED_WEB_DIR="$source_dir/apps/web/dist"
if [[ $interactive == false && ! -f ${WEB_CONFIG_DIR:-$CRABOT_BUNDLED_WEB_DIR}/index.html ]]; then
  command -v pnpm >/dev/null || { printf '请先 pnpm install && pnpm web:build，或指定 WEB_CONFIG_DIR。\n' >&2; exit 1; }
  pnpm web:build
fi
if command -v cargo >/dev/null; then
  exec cargo run -p agent-node --bin agent-node -- ${startup_args[@]+"${startup_args[@]}"}
fi
for binary in target/release/agent-node target/debug/agent-node; do
  if [[ -x $binary ]]; then exec "$binary" ${startup_args[@]+"${startup_args[@]}"}; fi
done
printf '未找到 Rust cargo 或已编译的 agent-node。\n' >&2
exit 1
