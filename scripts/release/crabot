#!/usr/bin/env bash
set -euo pipefail
export CRABOT_LAUNCH_DIR="$PWD"
launcher=${BASH_SOURCE[0]}
while [[ -L "$launcher" ]]; do
  parent=$(cd -P -- "$(dirname -- "$launcher")" && pwd)
  launcher=$(readlink "$launcher")
  [[ $launcher == /* ]] || launcher="$parent/$launcher"
done
bundle=$(cd -P -- "$(dirname -- "$launcher")/.." && pwd)
export CRABOT_BUNDLED_SYSTEM_SKILLS_DIR="$bundle/skills/system"
export CRABOT_BUNDLED_WEB_DIR="$bundle/web"
if [[ ${1:-} == --headless ]]; then
  shift
  exec "$bundle/libexec/agent-node" "$@"
fi
exec "$bundle/libexec/agent-node" --cli "$@"
