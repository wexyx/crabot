# Startup-only configuration. Copy to ~/.crabot/.agent.env (or an instance directory).
# A launch-directory .agent.env overrides instance defaults. Literal KEY=value, not shell code.
# Default: ~/.crabot (omit to use the user home directory)
# CRABOT_DATA_DIR=/absolute/path/to/instance
BIND_ADDR=127.0.0.1:8787
# Remote Web: set BIND_ADDR=0.0.0.0:8787 and a strong token (openssl rand -hex 32).
# Browser login: username crabot, password WEB_ACCESS_TOKEN. Use HTTPS on public networks.
# WEB_ACCESS_TOKEN=
AGENT_MODE=agent
ADMIN_AGENT_PROVIDER=crabot
MODEL_PROVIDER=deepseek
MODEL_NAME=your-tool-capable-model
MODEL_API_KEY=your-model-service-key
# MODEL_BASE_URL=https://model.example/v1
# MODEL_API=chat
# MODEL_SYSTEM_PROMPT=leave empty to use the built-in default
# Default workdir: user home directory
# AGENT_WORKDIR=/absolute/workdir
# Per-project history index buffer ceiling in MiB (64–8192, default 1024; allocated on demand).
# CRABOT_HISTORY_BUFFER_MIB=1024
AGENT_OUTSIDE_ACCESS=deny
# WEB_CONFIG_ORIGINS=https://config.example.com,http://localhost:5173
# Optional native Python execution. Skills also require a per-skill execution grant.
# CRABOT_EXECUTION_PROFILES_JSON=[{"id":"default","network":"host","timeout_seconds":30}]
# CRABOT_EXECUTION_PROFILE=default
# CRABOT_EXECUTION_ALLOWED_PROFILES=default
